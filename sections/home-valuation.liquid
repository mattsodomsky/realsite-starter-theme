{% comment %} The classic seller-lead form. {% form 'valuation' %} posts to
the platform and the lead lands in the CRM tagged with this page. {% endcomment %}
<section class="section valuation" id="home-value">
  <div class="shell narrow">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="muted">{{ section.settings.subheading | escape }}</p>
    {% form 'valuation' %}
      {% if site.areas.size > 0 %}
        <select name="area" aria-label="Your neighbourhood">
          <option value="">Your neighbourhood</option>
          {% for area in site.areas %}<option value="{{ area | escape }}">{{ area | escape }}</option>{% endfor %}
        </select>
      {% endif %}
      <label>Your property address<input type="text" name="address" autocomplete="street-address" required></label>
      <label>Email<input type="email" name="email" autocomplete="email" required></label>
      <button class="button" type="submit">{{ section.settings.button_label | escape }}</button>
      <p data-form-success hidden>Thank you. Your valuation request has been sent to {{ site.agent_name | escape }}.</p>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Home valuation",
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "What is your home worth?" },
    { "id": "subheading", "type": "text", "label": "Subheading",
      "default": "A straight answer from someone who knows your street." },
    { "id": "button_label", "type": "text", "label": "Button label", "default": "Get my valuation" }
  ]
}
{% endschema %}
