{% comment %} The workhorse: a heading and paragraphs. Blank lines in the
textarea become paragraph breaks via newline_to_br. {% endcomment %}
<section class="section">
  <div class="shell narrow">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    <div class="prose">{{ section.settings.body | newline_to_br }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "" },
    { "id": "body", "type": "textarea", "label": "Body" }
  ]
}
{% endschema %}
