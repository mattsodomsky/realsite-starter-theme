<article class="shell narrow">
  <time class="muted">{{ post.published_on | escape }}</time>
  <h1>{{ post.title | escape }}</h1>
  <div class="prose">{{ post.body | escape | newline_to_br }}</div>
  <p><a href="/blog">&larr; All posts</a></p>
</article>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":{{ post.title | json }},"datePublished":{{ post.published_at_iso | json }},"author":{"@type":"Person","name":{{ site.agent_name | json }}}}</script>
